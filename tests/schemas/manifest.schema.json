{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafeeq.training/schemas/manifest.schema.json",
  "title": "Rafeeq submission manifest",
  "description": "Deterministic inventory and safety-check result generated at export time.",
  "type": "object",
  "required": [
    "schema_version", "generated_at_utc", "expected_final_commit_message",
    "files", "safety_checks", "all_passed"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "expected_final_commit_message": {"type": "string", "minLength": 1, "maxLength": 200},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "safety_checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "boolean"}
    },
    "all_passed": {"type": "boolean"}
  },
  "additionalProperties": true
}
